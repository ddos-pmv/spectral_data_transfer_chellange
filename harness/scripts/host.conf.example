# Настройки машины для прогонов. Скопировать в host.conf и поправить под себя:
#
#   cp scripts/host.conf.example scripts/host.conf
#
# host.conf в .gitignore: PCI, MAC и адреса у двух машин разные, им не место
# в репозитории. Любую переменную можно перебить из окружения, она сильнее
# файла:  OFFLINE_CPUS= ./scripts/cpu.sh apply

# ---------------------------------------------------------------- карта DPDK
DPDK_IFACE=enp40s0        # вторая ENI. НЕ ens5 -- на нём SSH, отвяжете и потеряете машину
DPDK_PCI=                 # пусто = вывести из DPDK_IFACE, пока он ещё виден ядру
DPDK_ENI_INDEX=1          # device-index этой ENI, чтобы читать MAC/IP из метаданных
DPDK_DRIVER=igb_uio       # igb_uio (нужен для Write Combining) или vfio-pci
KERNEL_DRIVER=ena         # куда возвращать карту на unbind

# -------------------------------------------------------------------- ядра
# Сверяется с isolcpus в /proc/cmdline, само не применяется -- это GRUB и reboot.
ISOL_CPUS=1,2
IRQ_CPUS=0                # куда сгонять все прерывания (housekeeping-ядро)
OFFLINE_CPUS=3            # погасить: SMT-сиблинги изолированных ядер
GOVERNOR=performance      # пусто = не трогать
NO_TURBO=                 # 1 = выключить turbo; на AWS файла нет, оставить пустым

# -------------------------------------------------------------------- память
HUGEPAGES_2M=256          # 512 МБ

# ------------------------------------------------------------------ прогоны
CPU_RECEIVER=1            # busy-poll -- на целое физическое ядро
CPU_CONSUMER=2
CPU_SENDER=1
CPU_PRODUCER=2
PORT=40001

# ------------------------------------------------- очереди NIC и пулы mbuf
# Границы печатает сам dpdk_sender/dpdk_reciever при старте, строки
# rx_desc_lim/tx_desc_lim в логе прогона. Выход за них -- отказ стартовать,
# а не молчаливое округление. Замеренное на c5n/net_ena (nb_align=1, так что
# степень двойки не обязательна):
#   rx_desc_lim: min 128, max 8192
#   tx_desc_lim: min 128, max 512   <-- потолок TX низкий, это не опечатка
SENDER_TXD=512            # дескрипторов в TX-очереди; у ENA это и есть максимум
                          # При LLQ_POLICY=3 карта может отдать меньше -- запись
                          # очереди вдвое крупнее, значит их влезает вдвое меньше.
                          # Отправитель тогда откажется стартовать и напечатает
                          # число, которое сюда надо вписать.

# Политика LLQ у ENA: 0 выключен, 1 по усмотрению карты, 2 обычный (запись 128 Б),
# 3 large (запись 256 Б, из них 224 под inline). Ставим 3, и это главная ручка
# всего решения: пакет здесь -- 42 Б заголовков + не более 176 Б кадра = 218 Б,
# то есть влезает в inline целиком. Карта забирает его записью в свою память и не
# идёт DMA-чтением за телом в память хоста; сэкономленный round-trip и есть
# основной выигрыш по хвосту. Формат в message.h ужат до 176 Б ровно под порог.
# `off` -- вообще не передавать devarg (поведение DPDK по умолчанию).
LLQ_POLICY=3
SENDER_MBUFS=8191         # mbuf в пуле отправителя; 2^n-1 -- ровно ложится на ring
RECEIVER_RXD=2048         # дескрипторов в RX-очереди; их нехватка = imissed
RECEIVER_MBUFS=8191

# ------------------------------------------------------------ получатели
# Заполнить из вывода `./scripts/nic.sh status` на той машине.
PEER_MAC=
PEER_IP=

# Адреса ПРИЁМНЫХ машин на УПРАВЛЯЮЩЕМ интерфейсе (ens5), не на карте под DPDK.
# По ним ходят замеры смещения из rx.sh/tx.sh: смещение -- свойство пары часов,
# а не пути, поэтому мерить удобнее там, где интерфейс всегда поднят.
#   на каждой приёмной машине: ip -4 -o addr show ens5
#
# Один получатель -- PROBE_PEER. Веер -- PROBE_PEERS: по адресу на каждого, в
# ТОМ ЖЕ порядке, что PEERS ниже, потому что RECEIVERS=N режет оба списка
# одинаково и смещение должно достаться тому получателю, у кого мерилось.
# Часы у машин расходятся независимо, поэтому поправка у каждой своя.
#
#   PROBE_PEERS="172.31.1.11 172.31.1.12 172.31.1.13 172.31.1.14"
PROBE_PEER=
PROBE_PEERS=""

# Веер на нескольких получателей. Пусто -- один получатель, PEER_MAC/PEER_IP
# выше. Иначе список через пробел в формате MAC@IP:PORT, и PEER_MAC/PEER_IP
# игнорируются:
#
#   PEERS="02:00:00:00:00:02@10.0.0.2:40001 02:00:00:00:00:03@10.0.0.3:40001"
#
# Каждому получателю отправитель отдаёт свою TX-очередь, если карта их даёт
# столько (`ethtool -l`, строка Combined); если меньше -- получатели делят
# очередь, и отправитель напечатает об этом при старте. Пакетов на проводе
# в любом случае N на сообщение: VPC не размножает мультикаст, размножает
# источник. Смотреть после прогона на pps_allowance_exceeded в статистике
# порта -- именно он отличает "упёрлись в квоту ENI" от "код медленный".
PEERS=""
